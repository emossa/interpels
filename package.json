{
  "name": "interpellevole",
  "version": "0.0.0",
  "private": true,
  "description": "Raccoglie gli interpelli per supplenze e invia a ogni Destinatario un Riepilogo giornaliero.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migra.ts",
    "db:migrate:produzione": "node --env-file=.env.produzione src/db/migra.ts",
    "destinatari": "node --env-file=.env.produzione src/cli/destinatari.ts",
    "job": "node --env-file-if-exists=.env src/cli/job.ts",
    "check:fonti": "node src/cli/check-fonti.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.3",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
