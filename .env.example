# Copia in `.env` (database di sviluppo, es. il branch `dev` di Neon)
# e in `.env.produzione` (database reale, usato da `pnpm destinatari`).
# Entrambi i file sono ignorati: non committarli mai.
DATABASE_URL=postgresql://utente:password@host.neon.tech/interpels?sslmode=require

# Solo per `pnpm job` senza --dry-run/--solo-raccolta: l'account Gmail che invia i Riepiloghi
# e una sua App Password (https://myaccount.google.com/apppasswords), mai la password dell'account.
GMAIL_UTENTE=
GMAIL_APP_PASSWORD=
